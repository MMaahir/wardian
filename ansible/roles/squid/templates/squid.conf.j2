# Wardian's proxy, the agent's only way out. Loopback only, CONNECT to 443
# only, allowlisted names only. The access rules and the allowlist come from
# the spike's phase 2 config (spike/phase-2-notes.md).

http_port 127.0.0.1:3128
pinger_enable off
# Otherwise Squid looks up its own host name at startup.
visible_hostname wardian
cache deny all
dns_nameservers {{ wardian_resolver }}
forwarded_for delete
via off
# Ubuntu's logrotate rotates Squid's logs, so Squid mustn't rotate them again.
logfile_rotate 0

acl CONNECT method CONNECT
acl SSL_ports port 443

# The agents' API and login hosts. -n matches the name as the client sent it:
# Squid never looks up a name or reverses an IP address for this ACL, so an
# IP literal never matches.
acl allowlist dstdomain -n api.anthropic.com chatgpt.com auth.openai.com

# dst resolves the name, so it comes after the allowlist deny. It stops an
# allowlisted name that resolves to a private address.
acl to_private dst 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 224.0.0.0/4 240.0.0.0/4
acl to_private dst ::/127 64:ff9b::/96 fc00::/7 fe80::/10 ff00::/8

http_access deny manager
http_access deny !CONNECT
http_access deny !SSL_ports
http_access deny !allowlist
http_access deny to_private
http_access allow localhost
http_access deny all
