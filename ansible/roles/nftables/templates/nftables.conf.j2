#!/usr/sbin/nft -f
# Wardian's firewall. Every user reaches public IPv4 addresses and the
# resolver. No user reaches an IPv4 address in private4 below, or any IPv6
# address off loopback, so nothing in the guest reaches the Mac or the LAN. The
# order is the one issue #1 gives.
#
# This file replaces only table inet wardian, never the whole ruleset. Lima
# keeps its own "ip nat" table in the guest, and `flush ruleset` would remove it.

define resolver4 = {{ wardian_resolver }}

table inet wardian
delete table inet wardian

table inet wardian {
	set private4 {
		type ipv4_addr; flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
			     169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16,
			     198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 }
	}

	# Named, so a control test can read them.
	counter dropped { }
	counter ipv6_dropped { }
	counter private4_dropped { }

	chain output {
		type filter hook output priority filter; policy drop;

		# 1. Replies and related traffic.
		ct state established,related accept

		# 2. Loopback, for every user.
		oif "lo" accept

		# 3. DNS to the resolver, for every user.
		ip daddr $resolver4 meta l4proto { tcp, udp } th dport 53 accept

		# 4. DHCP lease renewals. Lima's resolver and the Incus bridge are also
		# the DHCP server. The first lease comes over a packet socket, which
		# this chain never sees.
		meta skuid "systemd-network" ip daddr $resolver4 udp sport 68 udp dport 67 accept

		# 5. All IPv6 off loopback, public addresses included.
		meta nfproto ipv6 counter name "ipv6_dropped" jump drop_logged

		# 6. Private IPv4, which covers the rest of the resolver's ports, the
		# Mac's LAN address and the metadata address.
		ip daddr @private4 counter name "private4_dropped" jump drop_logged

		# 7. Everything else: public IPv4. Rules 5 and 6 come first, so the
		# mutation job can show each one is what stops its traffic.
		accept
	}

	# The log rule is rate-limited, so a flood can't fill the journal. The
	# drop rule has no limit, so every packet is counted and dropped.
	chain drop_logged {
		limit rate 10/second burst 20 packets log prefix "wardian-drop: " level info flags skuid
		counter name "dropped" drop
	}
}
